# Template for running a service outside Docker Compose.
# Copy to .env, tweak the values, and export them before starting uvicorn
# (e.g. `set -a; . ./.env; set +a`).

# --- core ---------------------------------------------------------------
ENVIRONMENT=local
LOG_FORMAT=json
LOG_LEVEL=INFO
# JWT_SECRET must be a long random string in anything but local demos.
JWT_SECRET=compose-dev-secret-change-me-0123456789abcdef
INTERNAL_SERVICE_TOKEN=dev-internal-token

# --- database -----------------------------------------------------------
# One database per service; adjust host/port to your Postgres.
DATABASE_URL=postgresql+asyncpg://app:app@127.0.0.1:5433/order_db
RUN_MIGRATIONS=true
DB_CONNECT_ATTEMPTS=30
DB_CONNECT_RETRY_DELAY_SECONDS=1

# --- kafka (optional; set KAFKA_ENABLED=true to run consumers/outbox) ---
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092

# --- observability ------------------------------------------------------
METRICS_ENABLED=true
ACCESS_LOG_ENABLED=true

# --- service wiring (order-service) -------------------------------------
PRODUCT_SERVICE_URL=http://127.0.0.1:8001
PAYMENT_SERVICE_URL=http://127.0.0.1:8004

# --- service module/port for uvicorn ------------------------------------
# SERVICE_MODULE=order_service.main:app
# PORT=8003
